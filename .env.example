APP_NAME="Outage Management System"
APP_ENV=local
APP_KEY=
# Production: APP_DEBUG=false (never expose stack traces)
APP_DEBUG=true
APP_URL=http://outagemanagement.test
# Timezone used to store and display times, e.g. Africa/Blantyre
APP_TIMEZONE=UTC
# Force https URLs when TLS terminates at the load balancer
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# Multi-node: use the cache store so `php artisan down` applies to every node
# APP_MAINTENANCE_DRIVER=cache
# APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL (recommended) or MySQL / MariaDB. Pick ONE block.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=outage_management
DB_USERNAME=oms
DB_PASSWORD=

# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=outage_management
# DB_USERNAME=oms
# DB_PASSWORD=
# DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Sessions / cache / queue
# Single server: database drivers work out of the box.
# Load-balanced: use Redis for all three so every node shares state
# (sessions, FIFO locks, onOneServer scheduler locks, dashboard cache).
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over https:
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=oms_

# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional dedicated queues (run workers with --queue=exports,default,notifications,reports)
OMS_NOTIFICATIONS_QUEUE=default
OMS_REPORTS_QUEUE=default
# Report exports: "exports" (listed first on the workers) lets them jump a backlog of notifications
OMS_EXPORTS_QUEUE=default

# Sending addresses (aliases) per kind of e-mail; empty = MAIL_FROM_ADDRESS. The mail account must be
# allowed to "Send As" each one. Email Templates can pick another alias per template.
OMS_MAIL_FROM_OUTAGES=outage@savannafibre.co.ug
OMS_MAIL_FROM_CUSTOMER_TICKETS=customertickets@savannafibre.co.ug
OMS_MAIL_FROM_SITE_VISITS=sitevisittickets@savannafibre.co.ug
OMS_MAIL_FROM_4G_OUTAGES=4Goutage@savannafibre.co.ug
OMS_MAIL_FROM_4G_TICKETS=4gtickets@savannafibre.co.ug
OMS_MAIL_FROM_EXECUTIVE=summaryexecutive@savannafibre.co.ug
OMS_MAIL_FROM_ALERTS=alerts-updates@savannafibre.co.ug

# Comma-separated load balancer IPs / CIDRs, or * behind a trusted LB only
TRUSTED_PROXIES=

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noc@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Real-time (Laravel Reverb)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
# Port the browser connects to (behind a proxy: 443) …
REVERB_PORT=8090
REVERB_SCHEME=http
# … and the port `php artisan reverb:start` binds to. Use a port no other app on this machine uses.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090
# Horizontal scaling of Reverb across several servers (requires Redis)
REVERB_SCALING_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# OMS
# ---------------------------------------------------------------------------
# Enforce authenticator-app MFA for every user
OMS_REQUIRE_MFA=false
# Send HSTS (only when the site is served exclusively over https)
OMS_HSTS=false
# Seed demo users/outages (ignored in production)
OMS_SEED_DEMO=true
OMS_REPORT_SCREEN_LIMIT=500

# Mobile app (dispatchers, technicians, engineers) — /api/v1
# Days a sign-in on a phone stays valid
OMS_MOBILE_TOKEN_DAYS=30
# Oldest app version still served, e.g. 1.2.0 (empty = any)
OMS_MOBILE_MIN_VERSION=
# Largest photo upload, in kilobytes
OMS_MOBILE_MAX_UPLOAD_KB=12288
# Notifications reach an open app over Reverb. For the background / a closed app they are pushed
# through Firebase Cloud Messaging: path of the service-account key downloaded from the Firebase
# console. Never commit that file. Empty = no push notifications (open app only).
OMS_FCM_CREDENTIALS=

# SMS alerts: log (development, nothing sent) | africastalking | twilio | http
SMS_DRIVER=log
# Sender ID / short code shown to recipients (must be registered with the provider)
SMS_SENDER=OMS
# Local numbers such as 0772123456 are converted to +256772123456
SMS_DEFAULT_COUNTRY_CODE=256
SMS_MAX_LENGTH=306

# Africa's Talking (SMS_DRIVER=africastalking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SANDBOX=true

# Twilio (SMS_DRIVER=twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Generic JSON provider (SMS_DRIVER=http): POST {to, message, sender} with a bearer token
SMS_URL=
SMS_TOKEN=
